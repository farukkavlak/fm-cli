<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>fm</AssemblyName>
    <RootNamespace>FmCli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <!-- The game bridge returns dynamically shaped JSON. Flow analysis cannot follow it through
         JsonElement, so the remaining warnings are all at that boundary; reads go through
         JsonRead/Field and are guarded at runtime. Real dereference/value warnings were fixed,
         not suppressed. Replace with typed DTOs before removing this list. -->
    <NoWarn>$(NoWarn);CS8600;CS8603;CS8604;CS8619;CS8620</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>FmCli.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="labels-turkish.tsv" LogicalName="labels-turkish.tsv" />
    <EmbeddedResource Include="Nl/common-words.txt" LogicalName="common-words.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.23.2" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

</Project>

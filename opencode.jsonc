{
  "$schema": "https://opencode.ai/config.json",
  // Gece otopilotu (tools/autopilot.sh): her turda tek bir bağımlılık maddesini taze bir
  // headless oturumda bitirir. Agent burada tanımlı ki model ve izinler (push yok, yıkıcı
  // komut yok) her turda aynı olsun. Kapsam ve kurallar tools/autopilot-prompt.md'de.
  "agents": {
    "autopilot": {
      "description": "Otomatik tur: BAGIMLILIKLAR CHECKLIST'ten tek madde (ölç → doğrula → commit).",
      "mode": "primary",
      "model": "opencode-go/deepseek-v4.1-flash",
      "system": "Bir turda tek bir taşınabilirlik maddesini bitiren otonom ajan. Kimseye soru sormaz. Ölçmeden değiştirmez; kanıtlanmayan değişikliği geri alıp park eder. Sabit bekleme yazmaz, oyunun kendi işaretini bekler. Yazı/konum/sıra yerine oyunun kimliğine tutunur. Push etmez.",
      "permissions": [
        { "action": "shell", "resource": "git push*", "effect": "deny" },
        { "action": "shell", "resource": "git reset --hard*", "effect": "deny" },
        { "action": "shell", "resource": "git clean*", "effect": "deny" },
        { "action": "shell", "resource": "rm -rf*", "effect": "deny" },
        { "action": "shell", "resource": "sudo*", "effect": "deny" }
      ]
    }
  }
}
